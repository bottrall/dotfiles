[pull]
	rebase = true
	tags = true
[fetch]
	# Off so squash-merged branches keep their origin/* ref; otherwise Claude
	# Code sees the worktree commits as unpushed and blocks session deletion.
	# Prune explicitly with `git fetch --prune` (sweep.sh does this).
	prune = false
	pruneTags = true
[push]
	default = current
	followTags = true
[status]
	showUntrackedFiles = all
[rebase]
	instructionFormat = [%an] - %s
[alias]
	pf = push --force-with-lease
	co = checkout
[user]
	name = Jake Bottrall
	email = 75273444+bottrall@users.noreply.github.com
[core]
	editor = vim
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
