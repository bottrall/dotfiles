{
  "position": "top",
  "height": 32,
  "modules-left": ["hyprland/workspaces"],
  // The centre stays empty: the webcam sits over the middle of the bar.
  "modules-center": [],
  // Modules sit at an even 24px rhythm (see style.css); tone does the grouping:
  // [media] [claude] [tray] [network volume] [cpu memory temperature] [clock] [idle notifications power]
  "modules-right": [
    "mpris",
    "custom/claude-usage",
    "tray",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "temperature",
    "clock",
    "idle_inhibitor",
    "custom/notification",
    "custom/power",
  ],
  "mpris": {
    "format": "{status_icon} {title}",
    "title-len": 30,
    "status-icons": {
      "playing": "󰐊",
      "paused": "󰏤",
      "stopped": "󰓛",
    },
    // Tooltips follow one shape: what it is (600), its values (secondary),
    // what a click does (tertiary). Alphas are relative to text.primary.
    "tooltip-format": "<span weight='600'>{title}</span>\n<span alpha='72%'>{artist}</span>\n<span alpha='49%'>{player} · click to play or pause</span>",
    "cursor": "default", // keep the normal arrow on hover
  },
  "tray": {
    // App names on hover add nothing next to their own icons.
    "tooltip": false,
    "icon-size": 16,
    // Gaps between icons come from CSS padding on the items instead of
    // "spacing", so the hover highlight covers the padded area too.
    "spacing": 0,
  },
  "network": {
    "format-wifi": "{icon} {signalStrength}%",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀 {ipaddr}",
    "format-linked": "󰈀 No IP",
    "format-disconnected": "󰤭 Off",
    "tooltip-format-wifi": "<span weight='600'>{essid}</span>\n<span alpha='72%'>Signal {signalStrength}% · {ipaddr}</span>\n<span alpha='49%'>Click for networks</span>",
    "tooltip-format-ethernet": "<span weight='600'>Wired · {ifname}</span>\n<span alpha='72%'>{ipaddr}</span>",
    "tooltip-format-disconnected": "<span weight='600'>Not connected</span>\n<span alpha='49%'>Click for networks</span>",
    "on-click": "~/.config/waybar/menus/toggle.sh wifi",
    "cursor": "default",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "scroll-step": 5,
    "tooltip-format": "<span weight='600'>{desc}</span>\n<span alpha='72%'>Volume {volume}%</span>\n<span alpha='49%'>Click to mute · scroll to adjust · right-click for the mixer</span>",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "cursor": "default",
  },
  // System stats sit in tertiary while healthy and only take a status
  // color past these thresholds (classes .warning / .critical).
  "cpu": {
    "format": " {usage}%",
    "states": { "warning": 70, "critical": 90 },
    "tooltip": false,
    "on-click": "ghostty --class=dev.jake.btop -e btop",
    "cursor": "default",
  },
  "memory": {
    "format": "󰍛 {}%",
    "states": { "warning": 70, "critical": 90 },
    "tooltip-format": "<span weight='600'>Memory</span>\n<span alpha='72%'>{used:0.1f} of {total:0.1f} GiB in use</span>\n<span alpha='49%'>Click for btop</span>",
    "on-click": "ghostty --class=dev.jake.btop -e btop",
    "cursor": "default",
  },
  "temperature": {
    // k10temp Tctl (CPU). Default thermal_zone0 is the Wi-Fi card; hwmonN
    // numbering isn't stable across boots, so resolve via the PCI device.
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "warning-threshold": 80,
    "critical-threshold": 90,
    "tooltip-format": "<span weight='600'>CPU temperature</span>\n<span alpha='72%'>{temperatureC} °C</span>\n<span alpha='49%'>Click for btop</span>",
    "on-click": "ghostty --class=dev.jake.btop -e btop",
    "cursor": "default",
    "format": "{icon} {temperatureC}°",
    "format-icons": ["", "", ""],
  },
  // Anchor of the right side: the date is dimmed with Pango alpha so only
  // the time reads as primary at 600.
  "clock": {
    "format": "<span alpha='72%'>{0:%a %d %b}</span>  <span weight='600'>{0:%H:%M}</span>",
    // Click opens the calendar menu (waybar/menus); it replaces the old
    // calendar tooltip.
    "tooltip": false,
    "on-click": "~/.config/waybar/menus/toggle.sh calendar",
    "cursor": "default",
  },
  "custom/claude-usage": {
    // Clawd (the Claude Code crab) + usage text in one module: the crab is a
    // CSS background so hover covers the whole unit. The Ruby script polls
    // the official usage endpoint; see claude-usage.rb.
    "exec": "~/.config/waybar/scripts/claude-usage.rb",
    "return-type": "json",
    // Re-render every minute for fresh countdowns; the Ruby script decides
    // on its own (cache TTL) when an actual API request is worth making.
    "interval": 60,
    "escape": false,
    "cursor": "default",
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪",
    },
    "tooltip-format-activated": "<span weight='600'>Keeping the screen awake</span>\n<span alpha='49%'>Click to let it sleep when idle</span>",
    "tooltip-format-deactivated": "<span weight='600'>Screen sleeps when idle</span>\n<span alpha='49%'>Click to keep it awake</span>",
    "cursor": "default",
  },
  "custom/notification": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󱅫",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "tooltip-format": "<span weight='600'>Notifications</span>\n<span alpha='72%'>{} unread</span>\n<span alpha='49%'>Click to open · right-click for Do not disturb</span>",
    "cursor": "default",
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/waybar/menus/toggle.sh power",
    "cursor": "default",
  },
}
