{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "cssPriority": "user",
  "positionX": "right",
  "positionY": "top",
  "control-center-width": 400,
  "control-center-height": -1,
  "fit-to-screen": false,
  "control-center-margin-top": 24,
  "control-center-margin-right": 24,
  "control-center-margin-bottom": 24,
  "notification-window-width": 428,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 200,
  "image-visibility": "when-available",
  "relative-timestamps": true,
  "notification-grouping": true,
  "hide-on-clear": true,
  "hide-on-action": true,
  "text-empty": "No notifications",
  "notification-visibility": {
    "spotify-track-changes": {
      "app-name": "^Spotify$",
      "state": "transient"
    }
  },
  "scripts": {
    "sound-normal": {
      "urgency": "Normal",
      "exec": "/home/jake/.config/swaync/sound.sh message"
    },
    "sound-critical": {
      "urgency": "Critical",
      "exec": "/home/jake/.config/swaync/sound.sh dialog-warning"
    }
  },
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "when-available"
    },
    "notifications": {
      "vexpand": false
    }
  }
}
