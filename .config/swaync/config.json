{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "cssPriority": "user",
  "positionX": "right",
  "positionY": "top",
  "control-center-width": 400,
  "control-center-margin-top": 20,
  "control-center-margin-right": 20,
  "control-center-margin-bottom": 20,
  "notification-window-width": 350,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "notification-grouping": true,
  "hide-on-clear": true,
  "hide-on-action": true,
  "text-empty": "No notifications",
  "scripts": {
    "sound-normal": {
      "urgency": "Low|Normal",
      "exec": "/home/jake/.config/swaync/sound.sh message"
    },
    "sound-critical": {
      "urgency": "Critical",
      "exec": "/home/jake/.config/swaync/sound.sh dialog-warning"
    }
  },
  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
