/* <%= header %>
   Template: hotglass/templates/calendar.css.erb. See hotglass/DESIGN.md.

   The clock dropdown (waybar/calendar/calendar.py): a level 3 overlay,
   right-aligned under the bar like the control center. Header: overline
   (the day, or "Today"), title, caption. Grid: tertiary day names,
   secondary numbers, today in primary with the accent mark beneath it,
   the selected day on fill.active. */

window.hotglass-calendar {
  background-color: <%= c(:surface_overlay) %>;
  border: <%= edge %> solid <%= c(:edge_default) %>;
  box-shadow: inset 0 1px 0 <%= c(:edge_highlight) %>;
  color: <%= c(:text_primary) %>;
  font-family: <%= ui_family %>;
  font-feature-settings: "tnum";
}

.hotglass-calendar .header {
  padding: <%= px(16) %> <%= px(20) %> <%= px(12) %>;
  border-bottom: <%= edge %> solid <%= c(:edge_hairline) %>;
}

.hotglass-calendar .overline {
  <%= font(:overline) %>
  text-transform: uppercase;
  color: <%= c(:text_tertiary) %>;
}

.hotglass-calendar .title {
  <%= font(:title) %>
  color: <%= c(:text_primary) %>;
  margin-top: <%= px(4) %>;
}

.hotglass-calendar .caption {
  <%= font(:caption) %>
  color: <%= c(:text_tertiary) %>;
  margin-top: 2px;
}

.hotglass-calendar calendar {
  padding: <%= px(8) %> <%= px(12) %> <%= px(12) %>;
  border: none;
  background: transparent;
  color: <%= c(:text_secondary) %>;
}

.hotglass-calendar calendar > header {
  border: none;
  background: transparent;
  padding: 0 0 <%= px(8) %>;
  color: <%= c(:text_primary) %>;
  <%= font(:ui) %>
  font-weight: 600;
}

.hotglass-calendar calendar > header > button {
  min-width: 28px;
  min-height: 28px;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  color: <%= c(:text_tertiary) %>;
}

.hotglass-calendar calendar > header > button:hover {
  background: <%= c(:fill_hover) %>;
  color: <%= c(:text_primary) %>;
}

.hotglass-calendar calendar > grid > label.day-name {
  <%= font(:caption) %>
  color: <%= c(:text_tertiary) %>;
  padding-bottom: <%= px(4) %>;
}

.hotglass-calendar calendar > grid > label.day-number {
  min-width: 40px;
  min-height: 34px;
  padding: 0;
  border-radius: 0;
  <%= font(:ui) %>
  color: <%= c(:text_secondary) %>;
}

.hotglass-calendar calendar > grid > label.day-number.other-month {
  color: <%= c(:text_disabled) %>;
}

.hotglass-calendar calendar > grid > label.day-number:hover {
  background: <%= c(:fill_hover) %>;
}

.hotglass-calendar calendar > grid > label.day-number:selected {
  background: <%= c(:fill_active) %>;
  color: <%= c(:text_primary) %>;
}

/* Today: primary, bolder, with the 16 x 2px accent mark beneath. */
.hotglass-calendar calendar > grid > label.day-number.today {
  color: <%= c(:text_primary) %>;
  font-weight: 700;
  box-shadow: none;
  background-image: linear-gradient(<%= c(:accent) %>, <%= c(:accent) %>);
  background-size: 16px <%= bar_mark %>;
  background-position: center 28px;
  background-repeat: no-repeat;
}

.hotglass-calendar calendar > grid > label.day-number.today:selected {
  background-color: <%= c(:fill_active) %>;
}
