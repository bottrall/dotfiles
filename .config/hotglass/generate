#!/usr/bin/env ruby
# frozen_string_literal: true

# hotglass token generator.
#
# Reads tokens.yml and rewrites every derived color file:
#
#   colors.css                     GTK @define-color tokens (waybar, swaync, gtk.css)
#   hotglass.conf                  Hyprland/hyprlock $variables
#   ../wofi/style.css              tokens spliced between markers (wofi loads its
#                                  stylesheet as inline data, so @import can't resolve)
#   ../clipse/custom_theme.json    clipse TUI theme (opaque fallbacks)
#   ../starship.toml               [palettes.hotglass] block between marker comments
#   ../../.local/share/icons/hotglass/
#                                  icon theme: folder + generic file glyphs
#                                  (inherits Adwaita for everything else)
#
# Stdlib only. Run from anywhere: paths resolve relative to this script.

require "fileutils"
require "json"
require "yaml"

HERE = __dir__
HEADER = "GENERATED by hotglass/generate — edit tokens.yml and rerun; do not edit this file."

# White at `alpha` flattened over pure black, as RRGGBB.
def composite_on_black(alpha)
  format("%02X", (255 * alpha).round) * 3
end

def rgba_css(hex6, alpha)
  r, g, b = hex6.scan(/../).map { |c| c.to_i(16) }
  "rgba(#{r}, #{g}, #{b}, #{format('%g', alpha)})"
end

# Replace the marker-delimited block in `path` with `block` (markers kept).
def splice(path, begin_marker, end_marker, block)
  src = File.read(path)
  pattern = /#{Regexp.escape(begin_marker)}.*?#{Regexp.escape(end_marker)}/m
  abort "#{File.basename(path)}: marker block #{begin_marker.inspect} not found" unless src.match?(pattern)
  File.write(path, src.sub(pattern, "#{begin_marker}\n#{block}\n#{end_marker}"))
end

tokens = YAML.load_file(File.join(HERE, "tokens.yml"))
accent = tokens.fetch("accent").fetch("hex")
accent_deep = tokens.fetch("accent").fetch("deep")
status = tokens.fetch("status")
alpha = tokens.fetch("alpha")
glass = tokens.fetch("glass")
raise_tiers = tokens.fetch("raise")

white = "FFFFFF"
black = "000000"
# Opaque fallbacks exist only for the white-alpha entries; the edge_focus*
# tokens are accent-based and would composite to meaningless grays.
ink = alpha.merge(raise_tiers)
           .reject { |name, a| a >= 1 || name.start_with?("edge_focus") }
           .transform_values { |a| composite_on_black(a) }

# ---- GTK-CSS tokens: colors.css + spliced into wofi -------------------
css = [
  "@define-color accent ##{accent};",
  "@define-color accent-deep ##{accent_deep};",
  *status.map { |name, hex6| "@define-color #{name} ##{hex6};" },
  "@define-color edge-focus #{rgba_css(accent, alpha['edge_focus'])};",
  "@define-color edge-focus-dim #{rgba_css(accent, alpha['edge_focus_dim'])};",
  "@define-color text #{rgba_css(white, alpha['text'])};",
  "@define-color text-dim #{rgba_css(white, alpha['text_dim'])};",
  "@define-color text-muted #{rgba_css(white, alpha['text_muted'])};",
  "@define-color edge-idle #{rgba_css(white, alpha['edge_idle'])};",
  "@define-color overlay-hover #{rgba_css(white, alpha['overlay_hover'])};",
  "@define-color edge-subtle #{rgba_css(white, alpha['edge_subtle'])};",
  "@define-color glass #{rgba_css(black, glass['glass'])};",
  "@define-color glass-thin #{rgba_css(black, glass['glass_thin'])};",
  "@define-color ink ##{black};",
  "",
  "/* Opaque fallbacks: the alpha ladder composited over black, for",
  "   surfaces that can't do transparency. */",
  *ink.reject { |name, _| name.start_with?("raise_") }
      .map { |name, hex6| "@define-color #{name.tr('_', '-')}-ink ##{hex6};" },
  *(1..3).map { |n| "@define-color raise-#{n} ##{ink["raise_#{n}"]};" },
]
File.write(File.join(HERE, "colors.css"), "/* #{HEADER} */\n\n#{css.join("\n")}\n")
splice(File.join(HERE, "../wofi/style.css"), "/* hotglass:begin */", "/* hotglass:end */",
       "/* #{HEADER} */\n#{css.join("\n")}")

# ---- hotglass.conf (hypr dialect) -------------------------------------
conf = [
  "# #{HEADER}",
  "",
  "$accent = rgb(#{accent})",
  "$accentAlpha = #{accent}",
  "$accentDeep = rgb(#{accent_deep})",
  *status.map { |name, hex6| "$#{name} = rgb(#{hex6})" },
  "$edgeFocus = rgba(#{accent}#{format('%02x', (255 * alpha['edge_focus']).round)})",
  "$edgeIdle = rgba(#{white}#{format('%02x', (255 * alpha['edge_idle']).round)})",
  "$text = rgb(#{white})",
  "$ink = rgb(#{black})",
  "$textDimInk = rgb(#{ink['text_dim']})",
  "$textMutedInk = rgb(#{ink['text_muted']})",
  "$overlayHoverInk = rgb(#{ink['overlay_hover']})",
  "$raise1 = rgb(#{ink['raise_1']})",
  "$raise2 = rgb(#{ink['raise_2']})",
  "$raise3 = rgb(#{ink['raise_3']})",
]
File.write(File.join(HERE, "hotglass.conf"), "#{conf.join("\n")}\n")

# ---- clipse (opaque truecolor TUI over terminal glass) ----------------
clipse = {
  "_comment" => HEADER,
  "useCustomTheme" => true,
  "TitleFore" => "##{white}",
  "TitleBack" => "##{ink['raise_1']}",
  "TitleInfo" => "##{ink['text_dim']}",
  "NormalTitle" => "##{white}",
  "DimmedTitle" => "##{ink['text_muted']}",
  "SelectedTitle" => "##{accent}",
  "NormalDesc" => "##{ink['text_dim']}",
  "DimmedDesc" => "##{ink['text_muted']}",
  "SelectedDesc" => "##{accent}",
  "StatusMsg" => "##{status['green']}",
  "PinIndicatorColor" => "##{status['yellow']}",
  "SelectedBorder" => "##{accent}",
  "SelectedDescBorder" => "##{accent}",
  "FilteredMatch" => "##{accent}",
  "FilterPrompt" => "##{accent}",
  "FilterInfo" => "##{ink['text_dim']}",
  "FilterText" => "##{white}",
  "FilterCursor" => "##{accent}",
  "HelpKey" => "##{ink['text_muted']}",
  "HelpDesc" => "##{ink['text_muted']}",
  "PageActiveDot" => "##{accent}",
  "PageInactiveDot" => "##{ink['text_muted']}",
  "DividerDot" => "##{ink['text_muted']}",
  "PreviewedText" => "##{white}",
  "PreviewBorder" => "##{accent}",
}
File.write(File.join(HERE, "../clipse/custom_theme.json"), "#{JSON.pretty_generate(clipse)}\n")

# ---- starship palette block -------------------------------------------
palette = [
  "# #{HEADER}",
  "[palettes.hotglass]",
  "accent = \"##{accent}\"",
  "accentdeep = \"##{accent_deep}\"",
  *status.map { |name, hex6| "#{name} = \"##{hex6}\"" },
  "text = \"##{white}\"",
  "dim = \"##{ink['text_dim']}\"",
  "muted = \"##{ink['text_muted']}\"",
  "ink = \"##{black}\"",
  "raise1 = \"##{ink['raise_1']}\"",
  "raise2 = \"##{ink['raise_2']}\"",
  "raise3 = \"##{ink['raise_3']}\"",
]
splice(File.join(HERE, "../starship.toml"), "# hotglass:begin", "# hotglass:end", palette.join("\n"))

# ---- icon theme (folders + generic file glyphs) -----------------------
# Sharp geometry from the token palette: folders are a raised-glass tile
# with a voltage tab (the prompt's directory block, iconified); files are
# a notched page with a dim mark per family. Color means attention, so
# marks stay neutral. Everything not drawn here inherits from Adwaita.
icons_root = File.expand_path("../../.local/share/icons/hotglass", HERE)
body_fill = rgba_css(white, alpha["overlay_hover"])
outline = rgba_css(white, alpha["text_muted"])
mark = rgba_css(white, alpha["text_dim"])

svg = ->(inner) { "<!-- #{HEADER} -->\n<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\">\n#{inner}</svg>\n" }

folder_svg = lambda do |glyph|
  svg.call(<<~INNER)
    <rect x="6.5" y="13" width="19" height="7.5" fill="##{accent}"/>
    <rect x="8" y="22" width="48" height="28" fill="#{body_fill}" stroke="#{outline}" stroke-width="3"/>
  #{glyph.empty? ? '' : "  #{glyph}\n"}
INNER
end

page_svg = lambda do |marks|
  svg.call(<<~INNER)
    <path d="M15.5 9.5 h24 l9 9 v36 h-33 z" fill="#{body_fill}" stroke="#{outline}" stroke-width="3"/>
    <path d="M39.5 9.5 l9 9 h-9 z" fill="#{outline}"/>
  #{marks.empty? ? '' : "  #{marks}\n"}
INNER
end

text_lines = %(<path d="M23 32 h18 M23 39 h18 M23 46 h11" stroke="#{mark}" stroke-width="3"/>)
exec_prompt = %(<path d="M22 33 l7 6.5 l-7 6.5" fill="none" stroke="#{mark}" stroke-width="3"/><path d="M33 46 h9" stroke="#{mark}" stroke-width="3"/>)

# XDG special folders carry a dim glyph inside the body; the plain
# folder stays empty.
places = {
  "folder" => "",
  "folder-open" => "",
  "inode-directory" => "",
  "folder-remote" => "",
  "folder-documents" => %(<path d="M24 29 h16 M24 35 h16 M24 41 h10" stroke="#{mark}" stroke-width="3"/>),
  "folder-download" => %(<path d="M32 27 v13 M26 35 l6 6 l6 -6" fill="none" stroke="#{mark}" stroke-width="3"/>),
  "folder-music" => %(<path d="M25 43 v-7 M32 43 v-11 M39 43 v-9" stroke="#{mark}" stroke-width="4"/>),
  "folder-pictures" => %(<rect x="24" y="27" width="4.5" height="4.5" fill="#{mark}"/><path d="M22 43 l8 -11 l5 7 l3 -4 l6 8 z" fill="#{mark}"/>),
  "folder-videos" => %(<path d="M28 29 l11 7 l-11 7 z" fill="#{mark}"/>),
  "folder-templates" => %(<path d="M26 28 h12 v14 h-12 z" fill="none" stroke="#{mark}" stroke-width="2.5"/>),
  "folder-publicshare" => %(<path d="M26 43 l11 -10 M37 33 h-6.5 M37 33 v6.5" fill="none" stroke="#{mark}" stroke-width="3"/>),
  "user-desktop" => %(<path d="M24 28 h16 v10 h-16 z M32 38 v5" fill="none" stroke="#{mark}" stroke-width="2.5"/>),
}
# Marks per family. Every name Adwaita ships is shadowed here so no
# foreign icon leaks into a hotglass view via the inheritance chain.
image_mark = %(<rect x="23" y="25" width="5" height="5" fill="#{mark}"/><path d="M20 46 l9 -13 l6 8 l4 -5 l7 10 z" fill="#{mark}"/>)
audio_mark = %(<path d="M24 46 v-9 M32 46 v-15 M40 46 v-11" stroke="#{mark}" stroke-width="4"/>)
video_mark = %(<path d="M27 31 l13 8.5 l-13 8.5 z" fill="#{mark}"/>)
package_mark = %(<path d="M32 24 v5 M32 33 v5 M32 42 v5" stroke="#{mark}" stroke-width="4"/>)
grid_mark = %(<path d="M23 30 h18 v16 h-18 z M23 38 h18 M32 30 v16" fill="none" stroke="#{mark}" stroke-width="2.5"/>)
screen_mark = %(<path d="M22 30 h20 v12 h-20 z M32 42 v5" fill="none" stroke="#{mark}" stroke-width="2.5"/>)
angle_mark = %(<path d="M26 33 l-6 6.5 l6 6.5 M38 33 l6 6.5 l-6 6.5" fill="none" stroke="#{mark}" stroke-width="3"/>)
arrow_mark = %(<path d="M24 46 l14 -12 M38 34 h-7 M38 34 v7" fill="none" stroke="#{mark}" stroke-width="3"/>)

mimetypes = {
  "text-x-generic" => text_lines,
  "text-x-preview" => text_lines,
  "application-pdf" => text_lines,
  "x-office-document" => text_lines,
  "x-office-document-template" => text_lines,
  "x-office-addressbook" => text_lines,
  "text-x-script" => exec_prompt,
  "application-x-executable" => exec_prompt,
  "text-html" => angle_mark,
  "image-x-generic" => image_mark,
  "x-office-drawing" => image_mark,
  "audio-x-generic" => audio_mark,
  "video-x-generic" => video_mark,
  "package-x-generic" => package_mark,
  "x-package-repository" => package_mark,
  "x-office-spreadsheet" => grid_mark,
  "x-office-spreadsheet-template" => grid_mark,
  "x-office-presentation" => screen_mark,
  "x-office-presentation-template" => screen_mark,
  "inode-symlink" => arrow_mark,
  "application-octet-stream" => "",
  "application-x-generic" => "",
  "application-x-addon" => "",
  "application-x-firmware" => "",
  "application-x-sharedlib" => "",
  "application-certificate" => "",
  "font-x-generic" => "",
  "model" => "",
}

index_theme = <<~THEME
  # #{HEADER}
  [Icon Theme]
  Name=hotglass
  Comment=hotglass generated icon theme
  Inherits=Adwaita
  Directories=scalable/places,scalable/mimetypes

  [scalable/places]
  Context=Places
  Size=64
  MinSize=8
  MaxSize=512
  Type=Scalable

  [scalable/mimetypes]
  Context=MimeTypes
  Size=64
  MinSize=8
  MaxSize=512
  Type=Scalable
THEME

FileUtils.mkdir_p(["#{icons_root}/scalable/places", "#{icons_root}/scalable/mimetypes"])
File.write("#{icons_root}/index.theme", index_theme)
places.each { |name, glyph| File.write("#{icons_root}/scalable/places/#{name}.svg", folder_svg.call(glyph)) }
mimetypes.each { |name, marks| File.write("#{icons_root}/scalable/mimetypes/#{name}.svg", page_svg.call(marks)) }

puts "hotglass: wrote colors.css, hotglass.conf, clipse/custom_theme.json, wofi + starship blocks, icon theme"
