#!/usr/bin/env python3
"""hotglass token generator.

Reads tokens.toml and rewrites every derived color file:

  colors.css                     GTK @define-color tokens (waybar, wofi, swaync, gtk.css)
  hotglass.conf                  Hyprland/hyprlock $variables
  ../clipse/custom_theme.json    clipse TUI theme (opaque fallbacks)
  ../starship.toml               [palettes.hotglass] block between marker comments

Stdlib only. Run from anywhere: paths resolve relative to this script.
"""

import json
import re
import tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
HEADER = "GENERATED by hotglass/generate — edit tokens.toml and rerun; do not edit this file."


def composite_on_black(alpha: float) -> str:
    """White at `alpha` flattened over pure black, as RRGGBB."""
    v = round(255 * alpha)
    return f"{v:02X}{v:02X}{v:02X}"


def rgba_css(hex6: str, alpha: float) -> str:
    r, g, b = (int(hex6[i : i + 2], 16) for i in (0, 2, 4))
    return f"rgba({r}, {g}, {b}, {alpha:g})"


def main() -> None:
    tokens = tomllib.loads((HERE / "tokens.toml").read_text())
    accent = tokens["accent"]["hex"]
    status = tokens["status"]
    alpha = tokens["alpha"]
    glass = tokens["glass"]
    raise_ = tokens["raise"]

    white = "FFFFFF"
    black = "000000"
    # Opaque fallbacks exist only for the white-alpha entries; the edge_focus*
    # tokens are accent-based and would composite to meaningless grays.
    white_ladder = {k: v for k, v in {**alpha, **raise_}.items() if v < 1 and not k.startswith("edge_focus")}
    ink = {name: composite_on_black(a) for name, a in white_ladder.items()}

    # ---- colors.css -------------------------------------------------------
    css = [f"/* {HEADER} */", ""]
    css += [f"@define-color accent #{accent};"]
    css += [f"@define-color {name} #{hex6};" for name, hex6 in status.items()]
    css += [
        f"@define-color edge-focus {rgba_css(accent, alpha['edge_focus'])};",
        f"@define-color edge-focus-dim {rgba_css(accent, alpha['edge_focus_dim'])};",
        f"@define-color text {rgba_css(white, alpha['text'])};",
        f"@define-color text-dim {rgba_css(white, alpha['text_dim'])};",
        f"@define-color text-muted {rgba_css(white, alpha['text_muted'])};",
        f"@define-color edge-idle {rgba_css(white, alpha['edge_idle'])};",
        f"@define-color overlay-hover {rgba_css(white, alpha['overlay_hover'])};",
        f"@define-color edge-subtle {rgba_css(white, alpha['edge_subtle'])};",
        f"@define-color glass {rgba_css(black, glass['glass'])};",
        f"@define-color glass-thin {rgba_css(black, glass['glass_thin'])};",
        f"@define-color ink #{black};",
        "",
        "/* Opaque fallbacks: the alpha ladder composited over black, for",
        "   surfaces that can't do transparency. */",
    ]
    css += [
        f"@define-color {name.replace('_', '-')}-ink #{hex6};"
        for name, hex6 in ink.items()
        if not name.startswith("raise_")
    ]
    css += [f"@define-color raise-{n} #{ink[f'raise_{n}']};" for n in (1, 2, 3)]
    (HERE / "colors.css").write_text("\n".join(css) + "\n")

    # ---- hotglass.conf (hypr dialect) ------------------------------------
    conf = [f"# {HEADER}", ""]
    conf += [f"$accent = rgb({accent})", f"$accentAlpha = {accent}"]
    conf += [f"${name} = rgb({hex6})" for name, hex6 in status.items()]
    conf += [
        f"$edgeFocus = rgba({accent}{round(255 * alpha['edge_focus']):02x})",
        f"$edgeIdle = rgba({white}{round(255 * alpha['edge_idle']):02x})",
        f"$text = rgb({white})",
        f"$ink = rgb({black})",
        f"$textDimInk = rgb({ink['text_dim']})",
        f"$textMutedInk = rgb({ink['text_muted']})",
        f"$overlayHoverInk = rgb({ink['overlay_hover']})",
        f"$raise1 = rgb({ink['raise_1']})",
        f"$raise2 = rgb({ink['raise_2']})",
        f"$raise3 = rgb({ink['raise_3']})",
    ]
    (HERE / "hotglass.conf").write_text("\n".join(conf) + "\n")

    # ---- clipse (opaque truecolor TUI over terminal glass) ---------------
    clipse = {
        "_comment": HEADER,
        "useCustomTheme": True,
        "TitleFore": f"#{white}",
        "TitleBack": f"#{ink['raise_1']}",
        "TitleInfo": f"#{ink['text_dim']}",
        "NormalTitle": f"#{white}",
        "DimmedTitle": f"#{ink['text_muted']}",
        "SelectedTitle": f"#{accent}",
        "NormalDesc": f"#{ink['text_dim']}",
        "DimmedDesc": f"#{ink['text_muted']}",
        "SelectedDesc": f"#{accent}",
        "StatusMsg": f"#{status['green']}",
        "PinIndicatorColor": f"#{status['yellow']}",
        "SelectedBorder": f"#{accent}",
        "SelectedDescBorder": f"#{accent}",
        "FilteredMatch": f"#{accent}",
        "FilterPrompt": f"#{accent}",
        "FilterInfo": f"#{ink['text_dim']}",
        "FilterText": f"#{white}",
        "FilterCursor": f"#{accent}",
        "HelpKey": f"#{ink['text_muted']}",
        "HelpDesc": f"#{ink['text_muted']}",
        "PageActiveDot": f"#{accent}",
        "PageInactiveDot": f"#{ink['text_muted']}",
        "DividerDot": f"#{ink['text_muted']}",
        "PreviewedText": f"#{white}",
        "PreviewBorder": f"#{accent}",
    }
    (HERE / "../clipse/custom_theme.json").write_text(json.dumps(clipse, indent=2) + "\n")

    # ---- starship palette block ------------------------------------------
    starship_path = HERE / "../starship.toml"
    palette = [
        "# hotglass:begin — " + HEADER,
        "[palettes.hotglass]",
        f'accent = "#{accent}"',
    ]
    palette += [f'{name} = "#{hex6}"' for name, hex6 in status.items()]
    palette += [
        f'text = "#{white}"',
        f'dim = "#{ink["text_dim"]}"',
        f'muted = "#{ink["text_muted"]}"',
        f'ink = "#{black}"',
        f'raise1 = "#{ink["raise_1"]}"',
        f'raise2 = "#{ink["raise_2"]}"',
        f'raise3 = "#{ink["raise_3"]}"',
        "# hotglass:end",
    ]
    src = starship_path.read_text()
    block = "\n".join(palette)
    new, n = re.subn(r"# hotglass:begin.*?# hotglass:end", block, src, flags=re.S)
    if n != 1:
        raise SystemExit(f"starship.toml: expected 1 hotglass marker block, found {n}")
    starship_path.write_text(new)

    print("hotglass: wrote colors.css, hotglass.conf, clipse/custom_theme.json, starship palette")


if __name__ == "__main__":
    main()
