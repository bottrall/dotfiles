#!/usr/bin/env ruby
# frozen_string_literal: true

# hotglass 2.0 generator.
#
# Reads tokens.yml, audits contrast, then rewrites every derived file:
#
#   templates/*.erb  -> app stylesheets and configs (see TEMPLATES below),
#                       rendered with literal values: GTK3 consumers (waybar,
#                       wofi) can't resolve CSS custom properties, so every
#                       token is inlined at generate time
#   colors.css          GTK @define-color tokens, for ad-hoc stylesheets
#   hotglass.lua        Hyprland token table (colors, grid, shadow, blur, motion)
#   ../clipse/custom_theme.json, [palettes.hotglass] in ../starship.toml,
#   [color-palette] in ../satty/config.toml, the token table in DESIGN.md,
#   and the icon theme in ../../.local/share/icons/hotglass/
#
#   ./generate          audit, then write (aborts before writing on failure)
#   ./generate --check  print the full contrast table and exit; writes nothing
#
# Stdlib only. Run from anywhere: paths resolve relative to this script.

require "erb"
require "fileutils"
require "json"
require "yaml"

HERE = __dir__
HEADER = "GENERATED by hotglass/generate from tokens.yml — edit tokens.yml or templates/ and rerun; do not edit this file."

# Template -> output path, relative to this directory.
TEMPLATES = {
  "waybar.css.erb" => "../waybar/style.css",
  "wofi.css.erb" => "../wofi/style.css",
  "swaync.css.erb" => "../swaync/style.css",
  "swayosd.css.erb" => "../swayosd/style.css",
  "gtk4.css.erb" => "../gtk-4.0/gtk.css",
  "gtk3.css.erb" => "../gtk-3.0/gtk.css",
  "hyprlock.conf.erb" => "../hypr/hyprlock.conf",
  "ghostty.conf.erb" => "../ghostty/hotglass.conf",
}.freeze

# ---- color math (pure) -------------------------------------------------

module ColorMath
  module_function

  def rgb(hex6) = hex6.scan(/../).map { it.to_i(16) }
  def hex(channels) = channels.map { format("%02X", it.round.clamp(0, 255)) }.join

  # `fg` at `alpha` over opaque `bg`, as RRGGBB.
  def over(fg, alpha, bg) = hex(rgb(fg).zip(rgb(bg)).map { |f, b| (f * alpha) + (b * (1 - alpha)) })

  def luminance(hex6)
    rgb(hex6).map { it / 255.0 }
             .map { it <= 0.04045 ? it / 12.92 : ((it + 0.055) / 1.055)**2.4 }
             .zip([0.2126, 0.7152, 0.0722]).sum { |c, w| c * w }
  end

  def contrast(a, b)
    hi, lo = [luminance(a), luminance(b)].minmax.reverse
    (hi + 0.05) / (lo + 0.05)
  end
end

# ---- token model (pure) ------------------------------------------------

WHITE = "FFFFFF"
BLACK = "000000"

# Every color token as name => [hex6, alpha].
def color_table(t)
  accent = t.fetch("accent")
  alpha_group = ->(group, base, prefix) { t.fetch(group).to_h { |k, a| [:"#{prefix}_#{k}", [base, a]] } }
  {
    accent: [accent.fetch("base"), 1.0],
    accent_deep: [accent.fetch("deep"), 1.0],
    accent_soft: [accent.fetch("base"), accent.fetch("soft")],
    **t.fetch("status").to_h { |k, hex6| [k.to_sym, [hex6, 1.0]] },
    white: [WHITE, 1.0],
    ink: [BLACK, 1.0],
    **alpha_group.("text", WHITE, "text"),
    **alpha_group.("fill", WHITE, "fill"),
    **alpha_group.("edge", WHITE, "edge"),
    **alpha_group.("surface", BLACK, "surface"),
    **t.fetch("raise").to_h { |k, a| [k.to_sym, [ColorMath.over(WHITE, a, BLACK), 1.0]] },
  }.freeze
end

def css_color((hex6, alpha))
  return "##{hex6}" if alpha >= 1

  r, g, b = ColorMath.rgb(hex6)
  "rgba(#{r}, #{g}, #{b}, #{format('%g', alpha)})"
end

def hexa((hex6, alpha)) = "#{hex6}#{format('%02X', (alpha * 255).round)}"
def flat_hex((hex6, alpha)) = ColorMath.over(hex6, alpha, BLACK)

# ---- contrast audit (pure) ---------------------------------------------

def audit(t)
  check = t.fetch("check")
  backdrops = check.fetch("backdrops")
  minimum = check.fetch("minimum")
  inks = t.fetch("text").slice("primary", "secondary", "tertiary")
           .to_h { |role, a| [role, ->(ground) { ColorMath.over(WHITE, a, ground) }] }
           .merge("accent" => ->(_ground) { t.fetch("accent").fetch("base") })

  check.fetch("surfaces").flat_map do |surface, backdrop_names|
    backdrop_names.flat_map do |backdrop|
      ground = ColorMath.over(BLACK, t.fetch("surface").fetch(surface), backdrops.fetch(backdrop))
      inks.map do |role, ink|
        ratio = ColorMath.contrast(ink.(ground), ground)
        { surface:, backdrop:, role:, ratio:, min: minimum.fetch(role), pass: ratio >= minimum.fetch(role) }
      end
    end
  end
end

def audit_table(rows)
  rows.map do |r|
    format("  %-8s over %-6s %-10s %5.2f  (min %.1f)  %s", r[:surface], r[:backdrop], r[:role], r[:ratio], r[:min], r[:pass] ? "ok" : "FAIL")
  end.join("\n")
end

# ---- template context --------------------------------------------------

# What an .erb template can call. Immutable: it only formats tokens.
Context = Data.define(:t, :colors) do
  def c(name) = css_color(colors.fetch(name))
  def a(name) = hexa(colors.fetch(name))
  def flat(name) = "##{flat_hex(colors.fetch(name))}"
  def header = HEADER

  # Only space-scale values are allowed for padding, margins and gaps.
  # sp(n) is the bare number (for formats without units); px(n) adds "px".
  def sp(n)
    raise ArgumentError, "#{n}px is off the space scale #{t.fetch('space')}" unless t.fetch("space").include?(n)

    n
  end

  def px(n) = "#{sp(n)}px"

  def step(name) = t.fetch("type").fetch("scale").fetch(name.to_s)
  def size(name) = step(name)[0]
  def weight(name) = step(name)[1]

  # CSS declarations for a type step. Tracking is converted from em to px
  # because GTK3 only accepts absolute letter-spacing.
  def font(name)
    sz, wt, tracking = step(name)
    decls = ["font-size: #{sz}px;", "font-weight: #{wt};"]
    decls << "letter-spacing: #{format('%g', (sz * tracking).round(2))}px;" unless tracking.zero?
    decls.join(" ")
  end

  def ui_family = %("#{t.fetch('type').fetch('ui')}", "#{t.fetch('type').fetch('glyphs')}", sans-serif)
  def mono_family = %("#{t.fetch('type').fetch('mono')}", monospace)
  def ui_name = t.fetch("type").fetch("ui")
  def mono_name = t.fetch("type").fetch("mono")
  def mono_size = t.fetch("type").fetch("mono_size")

  def ms(name) = "#{t.fetch('motion').fetch(name.to_s)}ms"
  def curve(name) = "cubic-bezier(#{t.fetch('motion').fetch("#{name}_curve").join(', ')})"
  def mark = "#{t.fetch('shape').fetch('mark')}px"
  def bar_mark = "#{t.fetch('shape').fetch('bar_mark')}px"
  def edge = "#{t.fetch('shape').fetch('edge')}px"

  def shadow(level)
    x, y, range, alpha = t.fetch("elevation").fetch(level.to_s).fetch("shadow")
    "#{x} #{y}px #{range}px #{css_color([BLACK, alpha])}"
  end

  # Inset 1px top light + drop shadow: the overlay's edge catching light.
  def overlay_shadow = "inset 0 1px 0 #{c(:edge_highlight)}, #{shadow(:overlay)}"

  def render(src) = ERB.new(src, trim_mode: "-").result(binding)
end

# ---- derived outputs (pure: tokens -> string) --------------------------

def colors_css(colors)
  defines = colors.map { |name, value| "@define-color #{name.to_s.tr('_', '-')} #{css_color(value)};" }
  fallbacks = colors.select { |_, (hex6, a)| hex6 == WHITE && a < 1 }
                    .map { |name, value| "@define-color #{name.to_s.tr('_', '-')}-ink ##{flat_hex(value)};" }
  ["/* #{HEADER} */", "", *defines, "",
   "/* Opaque fallbacks: white-alpha tokens flattened over black. */", *fallbacks, ""].join("\n")
end

def lua_value(v)
  case v
  when Hash then "{ #{v.map { |k, x| "#{k} = #{lua_value(x)}" }.join(', ')} }"
  when Array then "{ #{v.map { lua_value(it) }.join(', ')} }"
  when String then v.inspect
  else format("%g", v)
  end
end

def hotglass_lua(t, colors)
  camel = ->(sym) { sym.to_s.gsub(/_(\w)/) { Regexp.last_match(1).upcase } }
  motion = t.fetch("motion")
  x, y, range, alpha = t.fetch("elevation").fetch("window").fetch("shadow")
  grid = t.fetch("grid")
  table = {
    color: colors.to_h { |name, value| [camel.(name), "rgba(#{hexa(value)})"] },
    border: t.fetch("shape").fetch("edge"),
    gapsIn: grid / 2,
    gapsOut: grid,
    dimInactive: t.fetch("elevation").fetch("window").fetch("dim_inactive"),
    shadow: { offset: [x, y], range:, color: "rgba(#{hexa([BLACK, alpha])})" },
    blur: t.fetch("blur").transform_keys(&:to_sym),
    # Hyprland animation speed is in deciseconds.
    speed: %w[fast base exit slow].to_h { [it.to_sym, motion.fetch(it) / 100.0] },
    curve: { enter: motion.fetch("enter_curve").each_slice(2).to_a, exit: motion.fetch("exit_curve").each_slice(2).to_a },
  }
  body = table.map { |k, v| "  #{k} = #{lua_value(v)}," }.join("\n")
  "-- #{HEADER}\nreturn {\n#{body}\n}\n"
end

def clipse_theme(colors)
  ink = ->(name) { "##{flat_hex(colors.fetch(name))}" }
  accent = ink.(:accent)
  {
    "_comment" => HEADER,
    "useCustomTheme" => true,
    "TitleFore" => ink.(:text_primary), "TitleBack" => ink.(:raise_1), "TitleInfo" => ink.(:text_secondary),
    "NormalTitle" => ink.(:text_primary), "DimmedTitle" => ink.(:text_tertiary), "SelectedTitle" => accent,
    "NormalDesc" => ink.(:text_secondary), "DimmedDesc" => ink.(:text_tertiary), "SelectedDesc" => accent,
    "StatusMsg" => ink.(:green), "PinIndicatorColor" => ink.(:yellow),
    "SelectedBorder" => accent, "SelectedDescBorder" => accent,
    "FilteredMatch" => accent, "FilterPrompt" => accent, "FilterInfo" => ink.(:text_secondary),
    "FilterText" => ink.(:text_primary), "FilterCursor" => accent,
    "HelpKey" => ink.(:text_tertiary), "HelpDesc" => ink.(:text_tertiary),
    "PageActiveDot" => accent, "PageInactiveDot" => ink.(:text_tertiary), "DividerDot" => ink.(:text_tertiary),
    "PreviewedText" => ink.(:text_primary), "PreviewBorder" => ink.(:edge_default),
  }
end

def starship_block(colors)
  ink = ->(name) { "\"##{flat_hex(colors.fetch(name))}\"" }
  ["# #{HEADER}", "[palettes.hotglass]",
   "accent = #{ink.(:accent)}", "accentdeep = #{ink.(:accent_deep)}",
   *%i[red yellow green blue].map { "#{it} = #{ink.(it)}" },
   "text = #{ink.(:text_primary)}", "dim = #{ink.(:text_secondary)}", "muted = #{ink.(:text_tertiary)}",
   "ink = #{ink.(:ink)}", "raise1 = #{ink.(:raise_1)}", "raise2 = #{ink.(:raise_2)}", "raise3 = #{ink.(:raise_3)}"].join("\n")
end

# Annotations exist to draw attention, so satty gets the accent and the full
# rail, plus white and ink for contrast on arbitrary screenshots. Order is
# the 1..7 quick-select keys. Satty wants RRGGBBAA.
def satty_block(colors)
  swatches = %i[accent red yellow green blue white ink].map { "\"##{hexa(colors.fetch(it))}\"" }
  ["# #{HEADER}", "[color-palette]", "palette = [#{swatches.join(', ')}]"].join("\n")
end

def design_table(colors)
  rows = colors.map { |name, value| "| `#{name.to_s.sub('_', '.')}` | `#{css_color(value)}` |" }
  ["<!-- #{HEADER} -->", "| Token | Value |", "|---|---|", *rows].join("\n")
end

# ---- icon theme --------------------------------------------------------
# Sharp geometry from the palette: folders are a raised-glass tile with a
# voltage tab (the accent as a mark); files are a notched page with a quiet
# glyph per family. Everything not drawn here inherits from Adwaita.

def icon_theme(colors)
  body_fill = css_color(colors.fetch(:fill_active))
  outline = css_color(colors.fetch(:text_tertiary))
  mark = css_color(colors.fetch(:text_secondary))
  accent = "##{colors.fetch(:accent).first}"

  svg = ->(inner) { "<!-- #{HEADER} -->\n<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\">\n#{inner}</svg>\n" }
  folder = lambda do |glyph|
    svg.(<<~INNER)
      <rect x="6.5" y="13" width="19" height="7.5" fill="#{accent}"/>
      <rect x="8" y="22" width="48" height="28" fill="#{body_fill}" stroke="#{outline}" stroke-width="3"/>
    #{glyph.empty? ? '' : "  #{glyph}\n"}
    INNER
  end
  page = lambda do |marks|
    svg.(<<~INNER)
      <path d="M15.5 9.5 h24 l9 9 v36 h-33 z" fill="#{body_fill}" stroke="#{outline}" stroke-width="3"/>
      <path d="M39.5 9.5 l9 9 h-9 z" fill="#{outline}"/>
    #{marks.empty? ? '' : "  #{marks}\n"}
    INNER
  end

  stroke = ->(d, width = 3) { %(<path d="#{d}" fill="none" stroke="#{mark}" stroke-width="#{width}"/>) }
  text_lines = stroke.("M23 32 h18 M23 39 h18 M23 46 h11")
  exec_prompt = stroke.("M22 33 l7 6.5 l-7 6.5") + stroke.("M33 46 h9")
  image = %(<rect x="23" y="25" width="5" height="5" fill="#{mark}"/><path d="M20 46 l9 -13 l6 8 l4 -5 l7 10 z" fill="#{mark}"/>)
  audio = stroke.("M24 46 v-9 M32 46 v-15 M40 46 v-11", 4)
  video = %(<path d="M27 31 l13 8.5 l-13 8.5 z" fill="#{mark}"/>)
  package = stroke.("M32 24 v5 M32 33 v5 M32 42 v5", 4)
  grid = stroke.("M23 30 h18 v16 h-18 z M23 38 h18 M32 30 v16", 2.5)
  screen = stroke.("M22 30 h20 v12 h-20 z M32 42 v5", 2.5)
  angle = stroke.("M26 33 l-6 6.5 l6 6.5 M38 33 l6 6.5 l-6 6.5")
  arrow = stroke.("M24 46 l14 -12 M38 34 h-7 M38 34 v7")

  places = {
    "folder" => "", "folder-open" => "", "inode-directory" => "", "folder-remote" => "",
    "folder-documents" => stroke.("M24 29 h16 M24 35 h16 M24 41 h10"),
    "folder-download" => stroke.("M32 27 v13 M26 35 l6 6 l6 -6"),
    "folder-music" => stroke.("M25 43 v-7 M32 43 v-11 M39 43 v-9", 4),
    "folder-pictures" => %(<rect x="24" y="27" width="4.5" height="4.5" fill="#{mark}"/><path d="M22 43 l8 -11 l5 7 l3 -4 l6 8 z" fill="#{mark}"/>),
    "folder-videos" => %(<path d="M28 29 l11 7 l-11 7 z" fill="#{mark}"/>),
    "folder-templates" => stroke.("M26 28 h12 v14 h-12 z", 2.5),
    "folder-publicshare" => stroke.("M26 43 l11 -10 M37 33 h-6.5 M37 33 v6.5"),
    "user-desktop" => stroke.("M24 28 h16 v10 h-16 z M32 38 v5", 2.5),
  }
  # Every name Adwaita ships is shadowed so no foreign icon leaks in.
  mimetypes = {
    "text-x-generic" => text_lines, "text-x-preview" => text_lines, "application-pdf" => text_lines,
    "x-office-document" => text_lines, "x-office-document-template" => text_lines, "x-office-addressbook" => text_lines,
    "text-x-script" => exec_prompt, "application-x-executable" => exec_prompt, "text-html" => angle,
    "image-x-generic" => image, "x-office-drawing" => image, "audio-x-generic" => audio, "video-x-generic" => video,
    "package-x-generic" => package, "x-package-repository" => package,
    "x-office-spreadsheet" => grid, "x-office-spreadsheet-template" => grid,
    "x-office-presentation" => screen, "x-office-presentation-template" => screen, "inode-symlink" => arrow,
    **%w[application-octet-stream application-x-generic application-x-addon application-x-firmware
         application-x-sharedlib application-certificate font-x-generic model].to_h { [it, ""] },
  }
  index = <<~THEME
    # #{HEADER}
    [Icon Theme]
    Name=hotglass
    Comment=hotglass generated icon theme
    Inherits=Adwaita
    Directories=scalable/places,scalable/mimetypes

    [scalable/places]
    Context=Places
    Size=64
    MinSize=8
    MaxSize=512
    Type=Scalable

    [scalable/mimetypes]
    Context=MimeTypes
    Size=64
    MinSize=8
    MaxSize=512
    Type=Scalable
  THEME

  {
    "index.theme" => index,
    **places.to_h { |name, glyph| ["scalable/places/#{name}.svg", folder.(glyph)] },
    **mimetypes.to_h { |name, marks| ["scalable/mimetypes/#{name}.svg", page.(marks)] },
  }
end

# ---- effects -----------------------------------------------------------

def path(rel) = File.expand_path(rel, HERE)

# Replace the marker-delimited block in `file` with `block` (markers kept).
def splice(file, begin_marker, end_marker, block)
  src = File.read(file)
  pattern = /#{Regexp.escape(begin_marker)}.*?#{Regexp.escape(end_marker)}/m
  abort "#{File.basename(file)}: marker block #{begin_marker.inspect} not found" unless src.match?(pattern)
  File.write(file, src.sub(pattern) { "#{begin_marker}\n#{block}\n#{end_marker}" })
end

def write(rel, content)
  FileUtils.mkdir_p(File.dirname(path(rel)))
  File.write(path(rel), content)
end

tokens = YAML.load_file(path("tokens.yml"))
colors = color_table(tokens)
rows = audit(tokens)
failures = rows.reject { it[:pass] }

if ARGV.include?("--check")
  puts "hotglass: contrast audit (text tiers and accent over each surface and backdrop)", audit_table(rows)
  exit(failures.empty? ? 0 : 1)
end
abort "hotglass: contrast audit failed — nothing written\n#{audit_table(failures)}" unless failures.empty?

context = Context.new(t: tokens, colors:)
TEMPLATES.each { |template, out| write(out, context.render(File.read(path("templates/#{template}")))) }

write("colors.css", colors_css(colors))
write("hotglass.lua", hotglass_lua(tokens, colors))
write("../clipse/custom_theme.json", "#{JSON.pretty_generate(clipse_theme(colors))}\n")
splice(path("../starship.toml"), "# hotglass:begin", "# hotglass:end", starship_block(colors))
splice(path("../satty/config.toml"), "# hotglass:begin", "# hotglass:end", satty_block(colors))
splice(path("DESIGN.md"), "<!-- hotglass:tokens:begin -->", "<!-- hotglass:tokens:end -->", design_table(colors))
icon_theme(colors).each { |rel, content| write("../../.local/share/icons/hotglass/#{rel}", content) }

puts "hotglass: contrast ok (#{rows.size} checks); wrote #{TEMPLATES.size} templates, colors.css, hotglass.lua, clipse, starship, satty, DESIGN.md table, icon theme"
