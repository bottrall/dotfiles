#!/usr/bin/env ruby
# frozen_string_literal: true

# hotglass token generator.
#
# Reads tokens.yml and rewrites every derived color file:
#
#   colors.css                     GTK @define-color tokens (waybar, swaync, gtk.css)
#   hotglass.conf                  Hyprland/hyprlock $variables
#   ../wofi/style.css              tokens spliced between markers (wofi loads its
#                                  stylesheet as inline data, so @import can't resolve)
#   ../clipse/custom_theme.json    clipse TUI theme (opaque fallbacks)
#   ../starship.toml               [palettes.hotglass] block between marker comments
#
# Stdlib only. Run from anywhere: paths resolve relative to this script.

require "json"
require "yaml"

HERE = __dir__
HEADER = "GENERATED by hotglass/generate — edit tokens.yml and rerun; do not edit this file."

# White at `alpha` flattened over pure black, as RRGGBB.
def composite_on_black(alpha)
  format("%02X", (255 * alpha).round) * 3
end

def rgba_css(hex6, alpha)
  r, g, b = hex6.scan(/../).map { |c| c.to_i(16) }
  "rgba(#{r}, #{g}, #{b}, #{format('%g', alpha)})"
end

# Replace the marker-delimited block in `path` with `block` (markers kept).
def splice(path, begin_marker, end_marker, block)
  src = File.read(path)
  pattern = /#{Regexp.escape(begin_marker)}.*?#{Regexp.escape(end_marker)}/m
  abort "#{File.basename(path)}: marker block #{begin_marker.inspect} not found" unless src.match?(pattern)
  File.write(path, src.sub(pattern, "#{begin_marker}\n#{block}\n#{end_marker}"))
end

tokens = YAML.load_file(File.join(HERE, "tokens.yml"))
accent = tokens.fetch("accent").fetch("hex")
status = tokens.fetch("status")
alpha = tokens.fetch("alpha")
glass = tokens.fetch("glass")
raise_tiers = tokens.fetch("raise")

white = "FFFFFF"
black = "000000"
# Opaque fallbacks exist only for the white-alpha entries; the edge_focus*
# tokens are accent-based and would composite to meaningless grays.
ink = alpha.merge(raise_tiers)
           .reject { |name, a| a >= 1 || name.start_with?("edge_focus") }
           .transform_values { |a| composite_on_black(a) }

# ---- GTK-CSS tokens: colors.css + spliced into wofi -------------------
css = [
  "@define-color accent ##{accent};",
  *status.map { |name, hex6| "@define-color #{name} ##{hex6};" },
  "@define-color edge-focus #{rgba_css(accent, alpha['edge_focus'])};",
  "@define-color edge-focus-dim #{rgba_css(accent, alpha['edge_focus_dim'])};",
  "@define-color text #{rgba_css(white, alpha['text'])};",
  "@define-color text-dim #{rgba_css(white, alpha['text_dim'])};",
  "@define-color text-muted #{rgba_css(white, alpha['text_muted'])};",
  "@define-color edge-idle #{rgba_css(white, alpha['edge_idle'])};",
  "@define-color overlay-hover #{rgba_css(white, alpha['overlay_hover'])};",
  "@define-color edge-subtle #{rgba_css(white, alpha['edge_subtle'])};",
  "@define-color glass #{rgba_css(black, glass['glass'])};",
  "@define-color glass-thin #{rgba_css(black, glass['glass_thin'])};",
  "@define-color ink ##{black};",
  "",
  "/* Opaque fallbacks: the alpha ladder composited over black, for",
  "   surfaces that can't do transparency. */",
  *ink.reject { |name, _| name.start_with?("raise_") }
      .map { |name, hex6| "@define-color #{name.tr('_', '-')}-ink ##{hex6};" },
  *(1..3).map { |n| "@define-color raise-#{n} ##{ink["raise_#{n}"]};" },
]
File.write(File.join(HERE, "colors.css"), "/* #{HEADER} */\n\n#{css.join("\n")}\n")
splice(File.join(HERE, "../wofi/style.css"), "/* hotglass:begin */", "/* hotglass:end */",
       "/* #{HEADER} */\n#{css.join("\n")}")

# ---- hotglass.conf (hypr dialect) -------------------------------------
conf = [
  "# #{HEADER}",
  "",
  "$accent = rgb(#{accent})",
  "$accentAlpha = #{accent}",
  *status.map { |name, hex6| "$#{name} = rgb(#{hex6})" },
  "$edgeFocus = rgba(#{accent}#{format('%02x', (255 * alpha['edge_focus']).round)})",
  "$edgeIdle = rgba(#{white}#{format('%02x', (255 * alpha['edge_idle']).round)})",
  "$text = rgb(#{white})",
  "$ink = rgb(#{black})",
  "$textDimInk = rgb(#{ink['text_dim']})",
  "$textMutedInk = rgb(#{ink['text_muted']})",
  "$overlayHoverInk = rgb(#{ink['overlay_hover']})",
  "$raise1 = rgb(#{ink['raise_1']})",
  "$raise2 = rgb(#{ink['raise_2']})",
  "$raise3 = rgb(#{ink['raise_3']})",
]
File.write(File.join(HERE, "hotglass.conf"), "#{conf.join("\n")}\n")

# ---- clipse (opaque truecolor TUI over terminal glass) ----------------
clipse = {
  "_comment" => HEADER,
  "useCustomTheme" => true,
  "TitleFore" => "##{white}",
  "TitleBack" => "##{ink['raise_1']}",
  "TitleInfo" => "##{ink['text_dim']}",
  "NormalTitle" => "##{white}",
  "DimmedTitle" => "##{ink['text_muted']}",
  "SelectedTitle" => "##{accent}",
  "NormalDesc" => "##{ink['text_dim']}",
  "DimmedDesc" => "##{ink['text_muted']}",
  "SelectedDesc" => "##{accent}",
  "StatusMsg" => "##{status['green']}",
  "PinIndicatorColor" => "##{status['yellow']}",
  "SelectedBorder" => "##{accent}",
  "SelectedDescBorder" => "##{accent}",
  "FilteredMatch" => "##{accent}",
  "FilterPrompt" => "##{accent}",
  "FilterInfo" => "##{ink['text_dim']}",
  "FilterText" => "##{white}",
  "FilterCursor" => "##{accent}",
  "HelpKey" => "##{ink['text_muted']}",
  "HelpDesc" => "##{ink['text_muted']}",
  "PageActiveDot" => "##{accent}",
  "PageInactiveDot" => "##{ink['text_muted']}",
  "DividerDot" => "##{ink['text_muted']}",
  "PreviewedText" => "##{white}",
  "PreviewBorder" => "##{accent}",
}
File.write(File.join(HERE, "../clipse/custom_theme.json"), "#{JSON.pretty_generate(clipse)}\n")

# ---- starship palette block -------------------------------------------
palette = [
  "# #{HEADER}",
  "[palettes.hotglass]",
  "accent = \"##{accent}\"",
  *status.map { |name, hex6| "#{name} = \"##{hex6}\"" },
  "text = \"##{white}\"",
  "dim = \"##{ink['text_dim']}\"",
  "muted = \"##{ink['text_muted']}\"",
  "ink = \"##{black}\"",
  "raise1 = \"##{ink['raise_1']}\"",
  "raise2 = \"##{ink['raise_2']}\"",
  "raise3 = \"##{ink['raise_3']}\"",
]
splice(File.join(HERE, "../starship.toml"), "# hotglass:begin", "# hotglass:end", palette.join("\n"))

puts "hotglass: wrote colors.css, hotglass.conf, clipse/custom_theme.json, wofi + starship blocks"
